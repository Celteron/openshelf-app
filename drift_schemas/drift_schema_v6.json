        }
      ]
    },
    {
      "name": "books",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"books\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"isbn13\" TEXT NULL UNIQUE, \"isbn10\" TEXT NULL, \"title\" TEXT NOT NULL, \"subtitle\" TEXT NULL, \"authors\" TEXT NOT NULL, \"publisher\" TEXT NULL, \"published_year\" INTEGER NULL, \"page_count\" INTEGER NULL, \"format\" TEXT NULL, \"language\" TEXT NULL, \"status\" TEXT NOT NULL DEFAULT 'unread', \"rating\" REAL NOT NULL DEFAULT 0.0, \"location_id\" INTEGER NULL REFERENCES locations (id) ON DELETE SET NULL, \"series_id\" INTEGER NULL REFERENCES series (id) ON DELETE SET NULL, \"series_volume\" REAL NULL, \"description\" TEXT NULL, \"cover_url\" TEXT NULL, \"cover_local_path\" TEXT NULL, \"metadata_source\" TEXT NULL, \"edited_fields\" TEXT NOT NULL, \"current_page\" INTEGER NOT NULL DEFAULT 0, \"finished_at\" INTEGER NULL, \"is_favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_favorite\" IN (0, 1)), \"review\" TEXT NULL, \"olid\" TEXT NULL, \"deleted_at\" INTEGER NULL, \"genre\" TEXT NULL, \"price_cents\" INTEGER NULL, \"received_at\" INTEGER NULL, \"reading_seconds\" INTEGER NULL, \"received_as\" INTEGER NULL, \"cover_not_found\" INTEGER NOT NULL DEFAULT 0 CHECK (\"cover_not_found\" IN (0, 1)), \"parent_id\" INTEGER NULL REFERENCES books (id) ON DELETE SET NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
