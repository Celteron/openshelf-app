        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"lending\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"book_id\" INTEGER NOT NULL REFERENCES books (id) ON DELETE CASCADE, \"borrower_name\" TEXT NOT NULL, \"lent_at\" INTEGER NOT NULL, \"expected_return\" INTEGER NULL, \"returned_at\" INTEGER NULL);"
